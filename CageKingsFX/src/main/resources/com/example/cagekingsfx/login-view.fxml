<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="300.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cagekingsfx.LoginController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="CAGE KINGS">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Label text="Login or Register to Play" />

    <TextField fx:id="usernameField" promptText="Username" maxWidth="250.0" />
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250.0" />

    <VBox alignment="CENTER" spacing="10.0">
        <Button text="Login" onAction="#handleLogin" prefWidth="120.0"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
        <Button text="Register" onAction="#handleRegister" prefWidth="120.0" />
    </VBox>

    <Label fx:id="statusLabel" textFill="RED" />
</VBox>